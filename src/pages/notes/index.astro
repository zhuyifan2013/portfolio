---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatNoteDateTime, getNoteTimes } from '../../utils/note-metadata';

const notes = await Promise.all(
  (await getCollection('notes')).map(async (note) => ({
    note,
    times: await getNoteTimes(note),
  }))
);
const renderedNotes = await Promise.all(
  notes
    .sort((a, b) => b.times.createdAt.valueOf() - a.times.createdAt.valueOf())
    .map(async ({ note, times }) => ({
      times,
      Content: (await note.render()).Content,
    }))
);
---

<BaseLayout title="Notes · Portfolio" description="Short notes and quick thoughts">
  <h1>Notes</h1>
  <p class="muted">Fast stream of notes—just timestamp and body.</p>
  <div class="feed">
    {renderedNotes.map(({ times, Content }) => (
      <article class="note-card">
        <div class="note-meta">{formatNoteDateTime(times.createdAt)}</div>
        <div class="note-body">
          <Content />
        </div>
      </article>
    ))}
  </div>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 6px;
  }
  .feed {
    margin-top: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .note-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 12px 14px;
    background: rgba(255, 255, 255, 0.65);
  }
  .note-meta {
    color: var(--muted);
    font-size: 0.92rem;
    text-align: right;
    margin-bottom: 6px;
  }
  .note-body :global(p) {
    margin: 0 0 0.6em;
    line-height: 1.7;
  }
  .note-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .note-body :global(ul),
  .note-body :global(ol) {
    padding-left: 1.1em;
    margin: 0 0 0.6em;
  }
  .note-body :global(code) {
    background: rgba(0, 0, 0, 0.04);
    border-radius: 6px;
    padding: 2px 6px;
  }
  .note-body :global(pre) {
    background: rgba(0, 0, 0, 0.04);
    border-radius: 10px;
    padding: 10px;
    overflow-x: auto;
  }
</style>
