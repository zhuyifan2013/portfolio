---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { formatNoteDateTime, getNoteTimes } from '../../utils/note-metadata';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { slug: note.slug },
    props: { note },
  }));
}

type Props = {
  note: CollectionEntry<'notes'>;
};

const { note } = Astro.props as Props;
const { Content } = await note.render();
const times = await getNoteTimes(note);
---

<BaseLayout title={`Note · ${note.slug}`} description="Quick note">
  <article class="article panel">
    <div class="meta">
      <span class="muted">{formatNoteDateTime(times.createdAt)}</span>
    </div>
    <div class="content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .content :global(code) {
    background: rgba(255, 255, 255, 0.06);
    padding: 2px 6px;
    border-radius: 6px;
  }
  .muted {
    color: var(--muted);
  }
</style>
